<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://orbita.local/OrbitaTV" version="0.1.0" viewmodes="maximized">
    <tizen:application id="OrbitaTV01.Orbita" package="OrbitaTV01" required_version="6.0"/>
    <content src="index.html"/>
    <name>Órbita</name>
    <icon src="icon.png"/>
    <!-- servidores IPTV são informados pelo usuário: origem arbitrária, normalmente sem CORS -->
    <access origin="*" subdomains="true"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
