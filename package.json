{
  "name": "orbita-tv",
  "version": "1.1.1",
  "private": true,
  "description": "Órbita — player IPTV para Samsung Smart TV (Tizen)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "wgt": "node scripts/build.mjs --wgt",
    "tv": "node scripts/build.mjs --wgt --install",
    "release": "node scripts/build.mjs --wgt --release",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "icon": "node scripts/make-icon.mjs",
    "preview": "node scripts/build.mjs --dev && node scripts/serve.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
