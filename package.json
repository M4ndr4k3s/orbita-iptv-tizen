{
  "name": "orbita-tv",
  "version": "1.1.2",
  "private": true,
  "description": "Órbita — player IPTV para Samsung Smart TV (Tizen 6+): M3U, Xtream Codes, EPG, filmes e séries, gravação no pendrive",
  "license": "GPL-3.0-or-later",
  "author": "M4ndr4k3s",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M4ndr4k3s/orbita-iptv-tizen.git"
  },
  "homepage": "https://github.com/M4ndr4k3s/orbita-iptv-tizen#readme",
  "bugs": {
    "url": "https://github.com/M4ndr4k3s/orbita-iptv-tizen/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "wgt": "node scripts/build.mjs --wgt",
    "tv": "node scripts/build.mjs --wgt --install",
    "release": "node scripts/build.mjs --wgt --release",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "icon": "node scripts/make-icon.mjs",
    "preview": "node scripts/build.mjs --dev && node scripts/serve.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
